{
  "name": "gaming-the-system-level-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:level1": "tsc --noEmit && vite build --mode level1 --outDir dist-level1",
    "build:level2": "tsc --noEmit && vite build --mode level2 --outDir dist-level2",
    "build:level3": "tsc --noEmit && vite build --mode level3 --outDir dist-level3",
    "package:previews": "npm run build && npm run build:level1 && npm run build:level2 && npm run build:level3 && python3 scripts/package_previews.py",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
